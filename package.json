{
  "name": "dsh-mcp-workbench",
  "version": "1.0.0",
  "type": "module",
  "description": "A minimal, elegant MCP server manager for the DeepSeek Harness Web GUI — add streamable-http/stdio servers, paste secrets as key/value headers, test connectivity, and toggle each tool on or off.",
  "icon": "icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "client/client.js",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "scripts/smoke.mjs",
    "scripts/selftest.mjs",
    "docs/screenshots",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node scripts/smoke.mjs",
    "selftest": "node scripts/selftest.mjs"
  },
  "license": "MIT",
  "author": "Xingyu Liu <xingyuliu@outlook.sg>",
  "homepage": "https://github.com/hxlog/dsh-mcp-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxlog/dsh-mcp-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/hxlog/dsh-mcp-workbench/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "mcp",
    "model-context-protocol",
    "mcp-manager",
    "mcp-servers",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  }
}
